# ZEO HRMS – server settings (v1.14.0). Copy to ".env" next to manage.py and fill in. Never commit the real .env.

# Required: a long random secret, e.g. from:  python -c "import secrets; print(secrets.token_urlsafe(50))"
ZEO_SECRET_KEY=change-me

# true only on a developer machine
ZEO_DEBUG=false
# host names / IPs the API is reached on (comma separated)
ZEO_ALLOWED_HOSTS=hr.example.com,localhost,127.0.0.1
# e.g. the current test server:  ZEO_ALLOWED_HOSTS=80.65.208.178,localhost,127.0.0.1,discharge-doctrine-superman.ngrok-free.dev
# addresses the Angular app is opened from (comma separated, with http/https and port)
ZEO_CORS_ORIGINS=https://hr.example.com,http://localhost:4200
# e.g. the current test server:  ZEO_CORS_ORIGINS=http://localhost:4200,http://80.65.208.178:4200

# PostgreSQL
ZEO_DB_NAME=zeo
ZEO_DB_USER=zeo_user
ZEO_DB_PASSWORD=change-me
ZEO_DB_HOST=127.0.0.1
ZEO_DB_PORT=5432

# Redis (Celery jobs and cache). ZEO_REDIS_CACHE_URL=locmem keeps the cache in memory if there is no Redis.
ZEO_CELERY_BROKER_URL=redis://localhost:6379/0
ZEO_REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# Fallback mail account (each company can also set its own under Settings → E-mail configuration).
# Leave ZEO_EMAIL_USER empty to write e-mails to the log instead of sending them.
ZEO_EMAIL_HOST=smtp.gmail.com
ZEO_EMAIL_PORT=587
ZEO_EMAIL_USE_TLS=true
ZEO_EMAIL_USER=
ZEO_EMAIL_PASSWORD=
ZEO_DEFAULT_FROM_EMAIL=

# "Ask ZEO" and the document reader ("Fill from document") use the built-in, free AI on this server by default.
# v1.16.0: a company administrator can connect an external AI (provider, address, model, API key) in
# Settings -> AI settings - ONLY when this server allows it. Keep false on a shared / SaaS server unless you want
# companies to be able to send data to outside AI services. ANTHROPIC_API_KEY / ZEO_AI_MODEL / ZEO_AI_URL are no longer used.
ZEO_AI_EXTERNAL=false
# Secret used to encrypt the API keys companies save (default: derived from ZEO_SECRET_KEY). If you set or change it
# (or change ZEO_SECRET_KEY without it), saved keys can no longer be read and administrators must enter them again.
# ZEO_AI_ENCRYPTION_KEY=
# true = the API address may be on this server or the local network (e.g. an on-premises OpenAI-compatible server).
# ZEO_AI_ALLOW_PRIVATE_URL=false

# ZEO Cloud (1.23.0) – only on Adept's cloud server; leave out on a customer's own server
ZEO_CLOUD=false
# who gets plan / app requests from customers
ZEO_CLOUD_ADMIN_EMAIL=
# ZEO Cloud own databases (1.24.0)
ZEO_PG_BIN=
ZEO_MOVE_SETTLE=12
# ZEO mobile app (1.25.0): Firebase service-account file for push notifications (empty = no push),
# the name the app shows for this server, days fingerprint sign-in works without use
ZEO_FCM_CREDENTIALS=
ZEO_SERVER_NAME=
ZEO_MOBILE_IDLE_DAYS=90

# ZEO Enterprise licence (1.28.0)
# On a client's own Enterprise server: enterprise (licence checks on). Leave empty on ZEO Cloud and older servers.
ZEO_EDITION=
# Adept's issuing server only: path of the private key from `zeo_licence keys --generate` (never in a package)
# ZEO_LICENCE_PRIVATE_KEY=/etc/zeo/licence_private.pem
# e-mail shown on Settings → Licence for renewals
ZEO_LICENCE_CONTACT=
# ZEO_LICENCE_GRACE_DAYS=15
# ZEO_LICENCE_EVALUATION_DAYS=30

# Odoo link for ZEO Cloud invoices and online payment (1.28.0) – Adept's cloud server only; empty = no Odoo
ZEO_ODOO_URL=
ZEO_ODOO_DB=
ZEO_ODOO_LOGIN=
ZEO_ODOO_API_KEY=
# product, sales tax and sales journal IDs in Odoo used for the invoice lines (empty = Odoo defaults, no tax)
ZEO_ODOO_PRODUCT_ID=
ZEO_ODOO_TAX_ID=
ZEO_ODOO_JOURNAL_ID=
